<div class="prs-layout{{#unless reports.length}} prs-no-nav{{/unless}}">
  {{#if reports.length}}
  <nav class="prs-nav">
    {{#each reports}}
    {{#if heading}}
    <div class="prs-nav-group">{{label}}</div>
    {{else}}
    <button type="button" class="prs-nav-item{{#if indent}} prs-indent{{/if}}{{#if active}} active{{/if}}" data-action="selectReport" data-report="{{id}}">{{label}}</button>
    {{/if}}
    {{/each}}
  </nav>
  {{/if}}
  <section class="prs-main">
    <header class="prs-controls">{{{controls}}}</header>
    <div class="prs-body">{{{body}}}</div>
  </section>
</div>
